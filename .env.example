# 文件範例；啟動骨架不需 secrets，也不會讀取此檔。
# identity 模式的連線設定須按程序分別注入；不共用管理帳號。
DATABASE_URL=postgresql://blink:local-only@127.0.0.1:5432/blink
BASE_SEPOLIA_RPC_URL=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
# 不把任何 signer private key 放進共用 env。

# M2.1 identity is opt-in. Supply separate credentials through each process's environment.
BLINK_API_MODE=scaffold
API_HOST=127.0.0.1
API_PORT=3001
# Only for API, using a non-owner login with blink_api membership:
API_DATABASE_URL=
# Canonical HTTPS origin; localhost HTTP is allowed for local development. No trailing slash.
WALLET_BINDING_ORIGIN=
# Only for the offline invitation/rotation/revocation CLI; never inject into the API:
IDENTITY_ADMIN_DATABASE_URL=

# M2.2a: BLINK_API_MODE=preparation enables evidence metadata and candidate revisions.
# Offline evidence CLI credential only; never inject into the API runtime:
EVIDENCE_ADMIN_DATABASE_URL=
# Evidence CLI writes; approval API requires a read-only mount of the same archive.
EVIDENCE_OBJECT_DIRECTORY=

# M2 approval is opt-in; does not enable signing or trading.
# BLINK_API_MODE=approval also enables identity/preparation routes.
SPEC_OBJECT_DIRECTORY=
# Public canonical HTTPS origin serving /v1/specs/:specHash; no trailing slash.
SPEC_PUBLIC_ORIGIN=
# Deployment registration CLI only (blink_deployment_admin group):
DEPLOYMENT_ADMIN_DATABASE_URL=
# CLI defaults to contracts/artifacts when this is not supplied:
# CONTRACT_ARTIFACT_DIRECTORY=contracts/artifacts

# Read-only chain observer CLI: separate non-owner login in blink_indexer.
# Never inject into the API or wallet process. This credential only writes observations.
INDEXER_DATABASE_URL=
