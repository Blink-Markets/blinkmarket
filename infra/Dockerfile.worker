# One service per image: the job worker. It needs WORKER_ENABLED=true and its own database login;
# without them it is a liveness-only stub. Evidence and model fixtures arrive as mounted volumes.
# Build context is the repository root: workspace dependencies are required.
FROM node:22.23.1-bookworm-slim AS build
WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@11.20.0 --activate
COPY . .
RUN pnpm install --frozen-lockfile && pnpm build:services

FROM node:22.23.1-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build --chown=node:node /repo/dist/services/worker.mjs ./worker.mjs
USER node
# The worker's health listener is fixed at 3002 and binds to loopback: only the container's own healthcheck reaches it.
EXPOSE 3002
# Liveness only; readiness is /health/ready, for the orchestrator.
HEALTHCHECK --interval=30s --timeout=5s CMD node -e "fetch('http://127.0.0.1:3002/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "worker.mjs"]
