# Build context is the repository root, not apps/api: workspace dependencies are required.
FROM node:22.23.1-bookworm-slim AS build
WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@11.20.0 --activate
COPY . .
RUN pnpm install --frozen-lockfile && pnpm build:services

FROM node:22.23.1-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production API_HOST=0.0.0.0 API_PORT=3001
COPY --from=build --chown=node:node /repo/dist/services/api.mjs ./api.mjs
USER node
EXPOSE 3001
# Liveness only. Trading/platform readiness deliberately remains 503 in M2.1.
HEALTHCHECK --interval=30s --timeout=5s CMD node -e "fetch('http://127.0.0.1:'+process.env.API_PORT+'/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "api.mjs"]
