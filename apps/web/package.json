{
  "name": "@blink/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "docs:md": "node --import tsx scripts/write-docs-md.ts",
    "dev": "pnpm run docs:md && next dev --hostname 127.0.0.1 --port 3000",
    "build": "pnpm run docs:md && next build",
    "build:pages": "BLINK_PAGES=1 NEXT_PUBLIC_BASE_PATH=/blinkmarket NEXT_PUBLIC_SITE_URL=https://blink-markets.github.io/blinkmarket pnpm run build && touch out/.nojekyll",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@blink/schemas": "workspace:*",
    "marked": "18.0.13",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "4.4.3"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
