# Copy to a protected runtime env file and replace every marker. Never commit the filled file.
BLINK_CHAIN_ID=84532
BLINK_API_MODE=<TO BE PROVIDED: markets>
API_HOST=<TO BE PROVIDED: API bind host>
API_PORT=<TO BE PROVIDED: API port>
API_TRUSTED_PROXIES=<TO BE PROVIDED: the TLS proxy's address as the API sees it, e.g. 127.0.0.1>
API_DATABASE_URL=<TO BE PROVIDED: API database URL>
WALLET_BINDING_ORIGIN=<TO BE PROVIDED: public API origin>
SPEC_OBJECT_DIRECTORY=<TO BE PROVIDED: spec object directory>
SPEC_PUBLIC_ORIGIN=<TO BE PROVIDED: public API origin, no path>
BLINK_DEPLOYMENT_ID=<TO BE PROVIDED: registered deployment ID>
BASE_SEPOLIA_RPC_URL=<TO BE PROVIDED: Base Sepolia RPC URL>

WORKER_ENABLED=<TO BE PROVIDED: true or false>
WORKER_DATABASE_URL=<TO BE PROVIDED: worker database URL>
ALERT_SINK=<TO BE PROVIDED: file or webhook>
ALERT_FILE_PATH=<TO BE PROVIDED: alert file path>
ALERT_WEBHOOK_URL=<TO BE PROVIDED: HTTPS alert webhook URL>
ALERT_RPC_FAILURES=<TO BE PROVIDED: RPC failure threshold>
ALERT_REALERT_MINUTES=<TO BE PROVIDED: alert repeat interval>

INDEXER_TX_TRACKING_ENABLED=<TO BE PROVIDED: true or false>
INDEXER_DATABASE_URL=<TO BE PROVIDED: indexer database URL>
INDEXER_PORT=<TO BE PROVIDED: indexer port>
INDEXER_HOST=<TO BE PROVIDED: indexer bind host>
INDEXER_RPC_TIMEOUT_MS=<TO BE PROVIDED: indexer RPC timeout>
CHAIN_INDEXER_ENABLED=<TO BE PROVIDED: true or false>
INDEXER_DEPLOYMENT_ID=<TO BE PROVIDED: registered deployment ID>
INDEXER_CHAIN_POLL_MS=<TO BE PROVIDED: chain poll interval>
INDEXER_CHAIN_RANGE=<TO BE PROVIDED: chain block range>


DATABASE_URL=<TO BE PROVIDED: migration database URL>
DEPLOYMENT_ADMIN_DATABASE_URL=<TO BE PROVIDED: deployment registration database URL>
# Operator tooling only (pnpm contracts:deploy, manifest:verify, deployment:register); no service reads these.
# contracts:deploy --broadcast also reads DEPLOYER_PRIVATE_KEY from the operator's own shell, never from a file; list it nowhere.
DEPLOY_RPC_URL=<TO BE PROVIDED: Base Sepolia deployment RPC URL>
CONTRACT_ARTIFACT_DIRECTORY=<TO BE PROVIDED: verified contract artifact directory>
RESTORE_ADMIN_DATABASE_URL=<TO BE PROVIDED: restore administrator database URL>
BLINK_API_URL=<TO BE PROVIDED: API origin for operator status>
BLINK_ADMIN_API_KEY=<TO BE PROVIDED: admin API key>
