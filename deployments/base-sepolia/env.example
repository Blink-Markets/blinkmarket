# Copy to a protected runtime env file and replace every marker. Never commit the filled file.
BLINK_CHAIN_ID=84532
BLINK_API_MODE=<TO BE PROVIDED: API mode>
API_HOST=<TO BE PROVIDED: API bind host>
API_PORT=<TO BE PROVIDED: API port>
API_TRUSTED_PROXIES=<TO BE PROVIDED: the TLS proxy's address as the API sees it, e.g. 127.0.0.1>
API_DATABASE_URL=<TO BE PROVIDED: API database URL>
WALLET_BINDING_ORIGIN=<TO BE PROVIDED: public API origin>
SPEC_OBJECT_DIRECTORY=<TO BE PROVIDED: spec object directory>
SPEC_PUBLIC_ORIGIN=<TO BE PROVIDED: public spec origin>
EVIDENCE_OBJECT_DIRECTORY=<TO BE PROVIDED: evidence object directory>
BLINK_DEPLOYMENT_ID=<TO BE PROVIDED: registered deployment ID>
SIGNER_URL=<TO BE PROVIDED: private signer URL>
SIGNER_CALLER_TOKEN=<TO BE PROVIDED: API signer caller token>
BASE_SEPOLIA_RPC_URL=<TO BE PROVIDED: Base Sepolia RPC URL>

WORKER_ENABLED=<TO BE PROVIDED: true or false>
WORKER_DATABASE_URL=<TO BE PROVIDED: worker database URL>
WORKER_PLATFORM_OPERATOR_ID=<TO BE PROVIDED: platform operator UUID>
WORKER_API_URL=<TO BE PROVIDED: internal API origin>
WORKER_MODEL_FIXTURES=<TO BE PROVIDED: reviewed REPLAY fixture file>
WORKER_DISCOVERY_API_KEY=<TO BE PROVIDED: discovery API key>
WORKER_DISCOVERY_MODEL=<TO BE PROVIDED: discovery model name>
WORKER_FORECASTER_A_API_KEY=<TO BE PROVIDED: forecaster A API key>
WORKER_FORECASTER_B_API_KEY=<TO BE PROVIDED: forecaster B API key>
WORKER_BASELINE_API_KEY=<TO BE PROVIDED: baseline API key>
WORKER_SIGNER_CALLER_TOKEN=<TO BE PROVIDED: worker signer caller token>
WORKER_TRADER_API_KEY=<TO BE PROVIDED: trader API key>
WORKER_TRADER_FORECASTER_ROLE=<TO BE PROVIDED: FORECASTER_A or FORECASTER_B>
ALERT_SINK=<TO BE PROVIDED: file or webhook>
ALERT_FILE_PATH=<TO BE PROVIDED: alert file path>
ALERT_WEBHOOK_URL=<TO BE PROVIDED: HTTPS alert webhook URL>
ALERT_RPC_FAILURES=<TO BE PROVIDED: RPC failure threshold>
ALERT_REALERT_MINUTES=<TO BE PROVIDED: alert repeat interval>
ALERT_KEEPER_OVERDUE_SECONDS=<TO BE PROVIDED: keeper overdue threshold>

INDEXER_CREATION_POLLING_ENABLED=<TO BE PROVIDED: true or false>
INDEXER_TX_TRACKING_ENABLED=<TO BE PROVIDED: true or false>
INDEXER_DATABASE_URL=<TO BE PROVIDED: indexer database URL>
INDEXER_PORT=<TO BE PROVIDED: indexer port>
INDEXER_HOST=<TO BE PROVIDED: indexer bind host>
INDEXER_POLL_INTERVAL_MS=<TO BE PROVIDED: indexer poll interval>
INDEXER_LEASE_MS=<TO BE PROVIDED: indexer lease duration>
INDEXER_RECONCILIATION_DEADLINE_MS=<TO BE PROVIDED: reconciliation deadline>
INDEXER_RETRY_BASE_MS=<TO BE PROVIDED: retry base interval>
INDEXER_RETRY_MAX_MS=<TO BE PROVIDED: retry maximum interval>
INDEXER_PENDING_POLL_MS=<TO BE PROVIDED: pending transaction poll interval>
INDEXER_CONFIRMED_POLL_MS=<TO BE PROVIDED: confirmed transaction poll interval>
INDEXER_REVERTED_POLL_MS=<TO BE PROVIDED: reverted transaction poll interval>
INDEXER_RPC_TIMEOUT_MS=<TO BE PROVIDED: indexer RPC timeout>
CHAIN_INDEXER_ENABLED=<TO BE PROVIDED: true or false>
INDEXER_DEPLOYMENT_ID=<TO BE PROVIDED: registered deployment ID>
INDEXER_CHAIN_POLL_MS=<TO BE PROVIDED: chain poll interval>
INDEXER_CHAIN_RANGE=<TO BE PROVIDED: chain block range>

SIGNER_ENABLED=<TO BE PROVIDED: true>
SIGNER_HOST=<TO BE PROVIDED: private signer bind host>
SIGNER_PORT=<TO BE PROVIDED: signer port>
SIGNER_DATABASE_URL=<TO BE PROVIDED: signer database URL>
SIGNER_DEPLOYMENT_ID=<TO BE PROVIDED: registered deployment ID>
SIGNER_CALLERS=<TO BE PROVIDED: caller token hashes and role allowlist JSON; the API caller gets exactly ["maker"], the worker caller exactly ["keeper","faucet"] plus "trader" only when WORKER_TRADER_API_KEY is set, with different tokens>
SIGNER_MAKER_KEY_FILE=<TO BE PROVIDED: maker key file path>
SIGNER_KEEPER_KEY_FILE=<TO BE PROVIDED: keeper key file path>
SIGNER_FAUCET_KEY_FILE=<TO BE PROVIDED: faucet key file path>
SIGNER_TRADER_KEY_FILE=<TO BE PROVIDED: trader key file path>
SIGNER_L1_FEE_MODE=<TO BE PROVIDED: oracle>

DATABASE_URL=<TO BE PROVIDED: migration database URL>
DEPLOYMENT_ADMIN_DATABASE_URL=<TO BE PROVIDED: deployment registration database URL>
DEPLOY_RPC_URL=<TO BE PROVIDED: Base Sepolia deployment RPC URL>
CONTRACT_ARTIFACT_DIRECTORY=<TO BE PROVIDED: verified contract artifact directory>
RESTORE_ADMIN_DATABASE_URL=<TO BE PROVIDED: restore administrator database URL>
BLINK_API_URL=<TO BE PROVIDED: API origin for operator status>
BLINK_ADMIN_API_KEY=<TO BE PROVIDED: admin API key>
