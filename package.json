{
  "name": "blinkmarket",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "typecheck": "tsc --noEmit && pnpm --filter @blink/web typecheck && pnpm --filter @blink/video typecheck",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "pnpm typecheck && pnpm check:contracts && pnpm test && pnpm check:boundaries",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:contracts": "node scripts/check-contracts.mjs",
    "test:contracts": "node scripts/foundry.mjs forge test --root contracts",
    "test:contracts:seeds": "node scripts/foundry.mjs forge test --root contracts --match-contract ProtocolInvariantTest --fuzz-seed 0x01 && node scripts/foundry.mjs forge test --root contracts --match-contract ProtocolInvariantTest --fuzz-seed 0x02",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "ops:status": "node --import tsx scripts/ops-status.ts",
    "manifest:validate": "node --import tsx scripts/validate-manifest.ts",
    "contracts:deploy": "node --import tsx scripts/deploy-contracts.ts",
    "manifest:verify": "node --import tsx scripts/verify-deployment.ts",
    "deployment:register": "node --import tsx scripts/register-deployment.ts",
    "deploy:preflight": "node --import tsx scripts/deploy-preflight.ts",
    "chain:rebuild": "node --import tsx scripts/rebuild-chain-index.ts",
    "api:spec": "node --import tsx scripts/generate-openapi.ts",
    "build": "pnpm --filter @blink/web build",
    "build:pages": "pnpm --filter @blink/web build:pages",
    "build:services": "node scripts/build-services.mjs",
    "test:service-build": "node --test tests/service-build.test.mjs",
    "test:postgres": "node --import tsx --test --test-concurrency=1 tests/postgres/*.test.ts",
    "test:anvil": "node --import tsx --test tests/anvil/*.test.ts",
    "test:browsers": "playwright test -c tests/browser/playwright.config.ts",
    "infra:up": "docker compose -f infra/compose.yaml up -d",
    "infra:down": "docker compose -f infra/compose.yaml down",
    "alpha:local": "node scripts/check-contracts.mjs && node --import tsx --test tests/alpha/local-alpha.test.ts",
    "alpha:serve": "node --import tsx scripts/alpha-serve.ts",
    "video:capture": "node --import tsx scripts/video-capture.ts",
    "alpha:autonomous": "node --import tsx scripts/alpha-autonomous.ts",
    "drill:alerts": "node --import tsx --test tests/postgres/alerts.test.ts",
    "restore:prepare": "node --import tsx scripts/restore-prepare.ts",
    "drill:restore": "node scripts/check-contracts.mjs && node --import tsx scripts/restore-drill.ts",
    "drill:restore:test": "node scripts/check-contracts.mjs && node --import tsx --test tests/alpha/restore-drill.test.ts",
    "images:build": "for s in api worker indexer; do docker build -f infra/Dockerfile.$s -t blink-$s:local . || exit 1; done",
    "test:images": "node --test tests/images.test.mjs",
    "check:cdp-wallet": "node --env-file-if-exists=${BLINK_CDP_ENV:-$HOME/.config/blink/cdp.env} tests/cdp/run.mjs tests/cdp/cdp-wallet.test.ts",
    "images:smoke": "node scripts/check-contracts.mjs && node --import tsx scripts/images-smoke.ts",
    "video:studio": "pnpm --dir video exec remotion studio src/index.ts",
    "video:render": "pnpm --dir video exec remotion render src/index.ts BlinkIntro ../tmp/video/blink-intro.mp4",
    "video:still": "pnpm --dir video exec remotion still src/index.ts BlinkIntro ../tmp/video/blink-intro-poster.png"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "pg": "8.23.0",
    "prettier": "3.9.8",
    "@foundry-rs/forge": "1.7.1",
    "@foundry-rs/anvil": "1.7.1",
    "@openzeppelin/contracts": "5.6.1",
    "@electric-sql/pglite": "0.5.8",
    "@types/pg": "8.23.1",
    "viem": "2.56.8",
    "@types/node": "22.20.4",
    "typescript": "5.9.3",
    "tsx": "4.23.15",
    "solc": "0.8.30",
    "@playwright/test": "1.63.0",
    "yaml": "2.9.1",
    "@coinbase/cdp-sdk": "1.60.0",
    "zod": "4.6.5"
  }
}
